# ─── SOIS Storefront — Frontend environment ───────────────────────────────────
# Copy to `.env.local` and fill in for local development.

# Base URL of the SOIS backend consumer API (include the /api/v1 prefix).
# Local docker-compose backend runs on :8000 (see backend Makefile `make up`).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional. Tenant UUID sent as the `X-Tenant-ID` header. Leave blank in the
# current single-tenant deployment — the backend falls back to the default
# "sois-store" tenant.
NEXT_PUBLIC_TENANT_ID=

# Public base URL for product media stored in S3. Product/category records carry
# S3 object *keys* (e.g. "products/abc/main.jpg"); the frontend joins them onto
# this base to render images. Use the bucket's public URL or a CDN in front of it.
# Example: https://sois-store-media.s3.ap-south-1.amazonaws.com
NEXT_PUBLIC_MEDIA_BASE_URL=

# Hostname of NEXT_PUBLIC_MEDIA_BASE_URL, used to allow-list next/image remote
# images (next.config.ts reads this). e.g. sois-store-media.s3.ap-south-1.amazonaws.com
NEXT_PUBLIC_MEDIA_HOSTNAME=

# Razorpay public key id. Optional — the checkout/initiate response also returns
# `razorpay_key_id`, which takes precedence; this is only a fallback.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
